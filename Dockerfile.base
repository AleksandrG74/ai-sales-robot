FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/app/data/hf_cache \
    TRANSFORMERS_CACHE=/app/data/hf_cache \
    SENTENCE_TRANSFORMERS_HOME=/app/data/hf_cache \
    TZ=Europe/Moscow

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        procps \
        cron \
        tzdata \
        ca-certificates \
        git \
    && rm -rf /var/lib/apt/lists/*

# === Базовые зависимости (без torch) ===
COPY requirements.txt /app/requirements.txt

RUN pip install --upgrade pip && \
    pip install --no-cache-dir \
        "numpy==1.26.4" \
        "httpx==0.27.0" \
        "tenacity==8.3.0" \
        "pydantic==2.7.1" \
        "pydantic-settings==2.2.1" \
        "SQLAlchemy==2.0.30" \
        "python-dotenv==1.0.1" \
        "apscheduler==3.10.4" \
        "fastapi==0.109.0" \
        "uvicorn[standard]==0.27.0" \
        "jinja2==3.1.3" \
        "python-multipart==0.0.9" \
        "aiogram==3.7.0" \
        "telethon==1.34.0"

# === torch CPU-only (не тянет CUDA) ===
RUN pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        "torch==2.3.0"

# === sentence-transformers + transformers (после torch) ===
RUN pip install --no-cache-dir \
        "transformers==4.40.2" \
        "sentence-transformers==2.7.0"

RUN mkdir -p /app/logs /app/data /app/data/strategies /app/data/raw_threads /app/data/hf_cache

CMD ["bash"]
