# === Telegram (user-account, для dialogues-miner) ===
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# === Telegram Bot (для telegram-worker, aiogram) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_CHAT_ID=

# === DeepSeek LLM ===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# === dialogues-miner web UI ===
DASHBOARD_USER=
DASHBOARD_PASS=
MINER_WEB_PORT=8001

# === ai-sales-robot web-backend ===
WEB_BACKEND_PORT=8000

# === Orchestrator ===
ORCHESTRATOR_HEALTHCHECK_INTERVAL=30
ORCHESTRATOR_RESTART_DELAY=5
ORCHESTRATOR_MAX_RESTARTS=0

# === Общее ===
LOG_LEVEL=INFO
TZ=Europe/Moscow

# === Пути (внутри контейнера) ===
ROBOT_DB_PATH=/app/data/robot.db
STRATEGIES_DIR=/app/data/strategies
RAW_THREADS_DIR=/app/data/raw_threads
CONFIGS_DIR=/app/configs

# === Embeddings ===
EMBEDDINGS_MODEL=cointegrated/rubert-tiny2
EMBEDDINGS_CACHE=/app/data/hf_cache
